{
    "name": "migears/i18n",
    "description": "Minimalist internationalization library — array and gettext translations, plus timezone-aware date rendering",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "authors": [
        {
            "name": "Sam X. Xu",
            "email": "samxxu@gmail.com"
        }
    ],
    "keywords": [
        "i18n",
        "translation",
        "internationalization",
        "l10n",
        "localization",
        "date",
        "timezone"
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.2"
    },
    "suggest": {
        "ext-gettext": "Required for GettextTranslator (native gettext support)"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\I18n\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\I18n\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
